# Cognee — copy to cognee.env (chmod 600). Pick ONE LLM option (see docs/SETUP.md, step 7).
# ENABLE_BACKEND_ACCESS_CONTROL is fixed from day one: if you change it later, the data does not migrate.
ENABLE_BACKEND_ACCESS_CONTROL=true
REQUIRE_AUTHENTICATION=true
FASTAPI_USERS_JWT_SECRET=__GENERAR__
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=__GENERAR__
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=__GENERAR__
TELEMETRY_DISABLED=1
COGNEE_LOG_SEARCH_HISTORY=false
SYSTEM_ROOT_DIRECTORY=/cognee-storage/system
DATA_ROOT_DIRECTORY=/cognee-storage/data

# ---- Option A: a provider's API (recommended for extraction quality) ----
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=__COMPLETAR__

# ---- Option B: Ollama on the host (free; slower). Uncomment this and comment out A. ----
# First: ollama pull llama3.1:8b   (~4.9 GB)
# Docker Desktop reaches the host at host.docker.internal (Linux: add extra_hosts to the cognee service, docs/FULL-SETUP.md).
# IMPORTANT: with Ollama use the `instructor` framework + the endpoint WITH /v1. The default (litellm_native) does not
# know llama3.1 supports JSON schema and falls back to grammar-less "JSON mode": the 8b model returns missing fields or
# lists where strings belong, validation fails (KnowledgeGraph / SummarizedContent) and a single bad chunk sinks the
# cognify of the WHOLE dataset (0 nodes). With instructor, Ollama applies the schema as a grammar and output always validates.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b          # validated by Cognee for extraction; qwen2.5 logs a warning (schema/drops)
# STRUCTURED_OUTPUT_FRAMEWORK=instructor
# LLM_ENDPOINT=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# OLLAMA_NUM_CTX=8192            # default 2048 is too short for prompt + schema + chunk

# ---- Embeddings: fixed on day one. Changing them later forces a full reindex. ----
# Local, free and multilingual (CPU, ~220 MB on first start; runs inside the Cognee container, not in Ollama).
# Recommended even with option A: reading and writing do not depend on a paid API for embeddings.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Multilingual / higher-quality alternative with OpenAI (paid):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=openai/text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
